# Trusted deployment origin. Local defaults stay unindexed.
SITE_URL=http://localhost:3000
ALLOW_INDEXING=false
# lead: encrypted local inbox; fallback: inbox only; urable: verified adapter required.
BOOKING_MODE=lead
# Outside public/ and web-served directories. Defaults to ./private-data.
LEAD_STORAGE_DIR=./private-data
# Optional base64 32-byte key. If absent, a local 32-byte key is created in the inbox.
# Keep the key and inbox backed up together. Never expose this directory.
LEAD_ENCRYPTION_KEY=
# Internal placeholders only, NOT verified Urable requirements or API names.
URABLE_API_URL=
URABLE_API_KEY=
URABLE_ACCOUNT_ID=
URABLE_LOCATION_ID=
URABLE_WEBHOOK_SECRET=
# Future analytics configuration: disabled until consent and provider wiring are approved.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
